# CRM Credentials
SOFTCODE_USER=your_softcode_username
SOFTCODE_PWD=your_softcode_password

PREPAID_USER=your_prepaid_username
PREPAID_PWD=your_prepaid_password

# Region settings are read from region.json. Copy region.example.json to
# region.json and set the region ID plus its CRM display names there.

# Target WhatsApp Groups (comma-separated if multiple)
WHATSAPP_GROUPS=Network Team Thrissur,ACSO Management

# Report Excel Path (defaults to repo root Daily Complint Tracker.xls)
TARGET_EXCEL_PATH=Daily Complint Tracker.xls

# Local WhatsApp Bot service (optional if using Docker bot on Ubuntu or localhost)
WHATSAPP_BOT_URL=http://localhost:3000
WHATSAPP_BOT_TOKEN=asianet

# CRM HTTPS SSL Certificate Verification (false for internal self-signed corporate portals, true for strict SSL)
CRM_SSL_VERIFY=false

# Telegram Control Bot Configuration
# 1. Create a bot with @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# 2. Add your Telegram user ID (comma-separated if multiple admins).
# Required: Unauthorized users will be denied access with their ID displayed.
TELEGRAM_ALLOWED_USERS=
# Default phone number used for quick-click test delivery (optional, e.g. +91XXXXXXXXXX)
TELEGRAM_TEST_PHONE=
# Systemd service unit name managed by Telegram bot controls
SYSTEMD_SERVICE_NAME=daily-work-report
