# Local user-exported backups & seeds with personal data
data/*.json
!data/seeds/sample_preset.json
data/seeds/*_backup.json
data/seeds/thrissur_config_backup.json

# Logs & Diagnostics
logs/*.log
!logs/.gitkeep

