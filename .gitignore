# Environment & Secrets
.env
*.env

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/

# Playwright WhatsApp Session Cache (sensitive user credentials)
data/whatsapp_session/
*.session

# Temporary ticket downloads
data/Pending*.xlsx
data/Pending*.csv

# Temporary generated reports & working copies
output/*.jpg
output/*.png
output/*.xls
output/*.xlsx
!output/.gitkeep

# Temporary databases and backups
backups/
temp_hist_*.db
*.tmp

# Runtime SQLite databases (User & District-Specific Data)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# Local user-exported backups (tracked baseline presets are kept in data/seeds/)
data/*.json
!data/seeds/*.json

# Logs & Diagnostics
logs/*.log
!logs/.gitkeep

# System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
